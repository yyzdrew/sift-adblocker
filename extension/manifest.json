{
  "manifest_version": 3,
  "name": "Sift Ad Blocker",
  "version": "0.1.0",
  "description": "Blocks ads and trackers using EasyList and EasyPrivacy, with per-site control and element collapsing.",

  "browser_specific_settings": {
    "gecko": {
      "id": "sift-adblocker@localhost",
      "strict_min_version": "121.0"
    }
  },

  "permissions": [
    "webRequest",
    "webRequestBlocking",
    "storage",
    "unlimitedStorage"
  ],

  "host_permissions": ["<all_urls>"],

  "background": {
    "scripts": ["background/main.js"],
    "type": "module"
  },

  "action": {
    "default_title": "Sift Ad Blocker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/generics.js", "content/cosmetic.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
